<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ClimSmart-OP - Auto Parser Demo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; overflow: hidden; }
        
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
        
        /* Pattern background untuk chat */
        .chat-bg {
            background-color: #e5ddd5;
            background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 20.5V18H0v-2h20v-2H0v-2h20v-2H0V8h20V6H0V4h20V2H0V0h22v20h2V0h2v20h2V0h2v20h2V0h2v20h2V0h2v20h2v2H20v-1.5zM0 20h2v20H0V20zm4 0h2v20H4V20zm4 0h2v20H8V20zm4 0h2v20h-2V20zm4 0h2v20h-2V20zm4 4h20v2H20v-2zm0 4h20v2H20v-2zm0 4h20v2H20v-2zm0 4h20v2H20v-2z' fill='%23047857' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
        }
        
        .bubble-enter {
            animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        .highlight-row {
            animation: highlight 2s ease-out forwards;
        }

        @keyframes popIn {
            0% { opacity: 0; transform: translateY(15px) scale(0.9); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        @keyframes highlight {
            0% { background-color: #d1fae5; }
            100% { background-color: transparent; }
        }

        /* Cursor berkedip untuk simulasi mengetik */
        .cursor-blink::after {
            content: '|';
            animation: blink 1s step-end infinite;
            color: #047857;
        }
        @keyframes blink { 50% { opacity: 0; } }
    </style>
</head>
<body class="bg-gray-100 text-gray-800">

    <!-- Layout Utama: Flex Column di Mobile, Flex Row di Desktop -->
    <div class="h-screen w-full flex flex-col lg:flex-row overflow-hidden">
        
        <!-- ================= SISI KIRI: APLIKASI ENUMERATOR (CHAT) ================= -->
        <div class="w-full lg:w-[400px] xl:w-[450px] h-[45vh] lg:h-full flex flex-col border-r border-gray-300 bg-white shadow-2xl z-20 shrink-0">
            <!-- Header Chat -->
            <header class="bg-emerald-600 text-white p-3.5 flex items-center gap-3 shrink-0 shadow-md">
                <div class="relative">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center border border-emerald-400 p-1">
                        <img src="https://climsmart-op.site/assets/clim-smart-op-logo.png" class="w-full h-full object-contain" />
                    </div>
                    <div class="w-3 h-3 bg-green-400 rounded-full border-2 border-emerald-600 absolute bottom-0 right-0"></div>
                </div>
                <div>
                    <h2 class="font-extrabold text-[15px] leading-tight flex items-center gap-1.5">
                        ClimSmart AI
                        <span class="bg-emerald-800 text-[9px] px-1.5 py-0.5 rounded-md uppercase tracking-wider font-bold">Bot</span>
                    </h2>
                    <p class="text-[11px] text-emerald-100 font-medium mt-0.5">Selalu Aktif - Parser Otomatis</p>
                </div>
            </header>

            <!-- Area Chat List -->
            <div id="chat-box" class="flex-grow chat-bg overflow-y-auto p-4 custom-scrollbar flex flex-col">
                <!-- Chat akan di-inject lewat JS -->
            </div>

            <!-- Input Area (Simulasi) -->
            <div class="bg-[#f0f2f5] p-2.5 flex items-end gap-2 shrink-0 z-10 relative">
                <div class="bg-white flex-grow rounded-2xl flex items-center border border-gray-200 overflow-hidden shadow-sm h-12 px-3">
                    <i data-lucide="smile" class="w-6 h-6 text-gray-400 mr-2 shrink-0"></i>
                    <!-- Element ini yang akan menampung teks animasi mengetik -->
                    <div id="typing-input" class="flex-grow text-[13px] text-gray-700 font-medium whitespace-nowrap overflow-hidden text-ellipsis cursor-blink"></div>
                    <i data-lucide="paperclip" class="w-5 h-5 text-gray-400 shrink-0 transform -rotate-45 ml-2"></i>
                </div>
                <button id="send-btn" class="w-12 h-12 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-md transition-all">
                    <i data-lucide="send" class="w-[18px] h-[18px] ml-1"></i>
                </button>
            </div>
        </div>

        <!-- ================= SISI KANAN: DASHBOARD ADMIN ================= -->
        <div class="flex-1 h-[55vh] lg:h-full overflow-y-auto bg-[#F8FAFC] custom-scrollbar flex flex-col">
            <!-- Header Admin -->
            <header class="bg-white/80 backdrop-blur-md border-b border-gray-200 sticky top-0 z-10 p-4 lg:px-8 flex justify-between items-center shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center text-emerald-600">
                        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h1 class="font-extrabold text-gray-800 text-lg leading-tight">Dashboard Admin</h1>
                        <p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Live Monitoring</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-100 shadow-sm">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    Sinkronisasi Real-Time
                </div>
            </header>

            <div class="p-4 lg:p-8 flex-grow">
                <!-- Summary Cards -->
                <div class="grid grid-cols-3 gap-3 lg:gap-6 mb-6">
                    <div class="bg-white p-4 lg:p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col lg:flex-row lg:items-center gap-3 lg:gap-5">
                        <div class="p-2 lg:p-3.5 bg-emerald-50 text-emerald-600 rounded-xl w-fit">
                            <i data-lucide="trees" class="w-5 h-5 lg:w-7 lg:h-7"></i>
                        </div>
                        <div>
                            <p class="text-[10px] lg:text-[11px] font-extrabold text-gray-400 uppercase tracking-widest mb-0.5">Total Janjang</p>
                            <h3 id="stat-janjang" class="text-lg lg:text-3xl font-extrabold text-gray-800 transition-all duration-300">0</h3>
                        </div>
                    </div>
                    <div class="bg-white p-4 lg:p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col lg:flex-row lg:items-center gap-3 lg:gap-5">
                        <div class="p-2 lg:p-3.5 bg-blue-50 text-blue-600 rounded-xl w-fit">
                            <i data-lucide="weight" class="w-5 h-5 lg:w-7 lg:h-7"></i>
                        </div>
                        <div>
                            <p class="text-[10px] lg:text-[11px] font-extrabold text-gray-400 uppercase tracking-widest mb-0.5">Total Tonase</p>
                            <h3 id="stat-tonase" class="text-lg lg:text-3xl font-extrabold text-gray-800 transition-all duration-300">0 <span class="text-xs lg:text-sm text-gray-500 font-bold">Ton</span></h3>
                        </div>
                    </div>
                    <div class="bg-white p-4 lg:p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col lg:flex-row lg:items-center gap-3 lg:gap-5">
                        <div class="p-2 lg:p-3.5 bg-red-50 text-red-600 rounded-xl w-fit">
                            <i data-lucide="alert-triangle" class="w-5 h-5 lg:w-7 lg:h-7"></i>
                        </div>
                        <div>
                            <p class="text-[10px] lg:text-[11px] font-extrabold text-gray-400 uppercase tracking-widest mb-0.5">Total Afkir</p>
                            <h3 id="stat-afkir" class="text-lg lg:text-3xl font-extrabold text-gray-800 transition-all duration-300">0 <span class="text-xs lg:text-sm text-gray-500 font-bold">Jjg</span></h3>
                        </div>
                    </div>
                </div>

                <!-- Data Table -->
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden flex flex-col">
                    <div class="p-4 border-b border-gray-100 bg-gray-50/80">
                        <h3 class="font-extrabold text-gray-800 text-sm">Log Data Masuk Harian</h3>
                    </div>
                    <div class="overflow-x-auto flex-grow">
                        <table class="w-full text-sm text-left whitespace-nowrap">
                            <thead class="bg-white text-gray-400 text-[10px] uppercase tracking-wider font-extrabold border-b border-gray-100">
                                <tr>
                                    <th class="px-5 py-3">Waktu</th>
                                    <th class="px-5 py-3">Blok</th>
                                    <th class="px-5 py-3 text-center">Janjang</th>
                                    <th class="px-5 py-3 text-center">Tonase</th>
                                    <th class="px-5 py-3 text-center">Afkir</th>
                                    <th class="px-5 py-3">Pemanen</th>
                                    <th class="px-5 py-3">Raw Input AI</th>
                                </tr>
                            </thead>
                            <tbody id="admin-table-body" class="divide-y divide-gray-50">
                                <!-- Baris tabel akan ditambahkan via JS -->
                            </tbody>
                        </table>
                        
                        <!-- Empty State -->
                        <div id="empty-state" class="p-10 text-center flex flex-col items-center justify-center opacity-50 transition-opacity">
                            <i data-lucide="inbox" class="w-12 h-12 mb-3 text-gray-400"></i>
                            <p class="font-bold text-gray-500 text-sm">Menunggu laporan dari lapangan...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPT LOGIKA ANIMASI & AUTO PARSER -->
    <script>
        // Inisialisasi ikon Lucide
        lucide.createIcons();

        // Elemen DOM
        const chatBox = document.getElementById('chat-box');
        const typingInput = document.getElementById('typing-input');
        const sendBtn = document.getElementById('send-btn');
        const adminTableBody = document.getElementById('admin-table-body');
        const emptyState = document.getElementById('empty-state');
        
        // Elemen Statistik
        const statJanjang = document.getElementById('stat-janjang');
        const statTonase = document.getElementById('stat-tonase');
        const statAfkir = document.getElementById('stat-afkir');

        // State Dashboard
        let totalStats = { janjang: 0, tonase: 0, afkir: 0 };
        let recordCount = 1;

        // Mendapatkan waktu saat ini
        const getTime = () => {
            const now = new Date();
            return `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
        };

        // Format angka (ribuan)
        const formatNumber = (num) => new Intl.NumberFormat('id-ID').format(num);

        // Fungsi Render Bubble Chat
        const addChatBubble = (type, text, rawData = null) => {
            const time = getTime();
            let bubbleHTML = '';
            
            if (type === 'bot_welcome') {
                bubbleHTML = `
                    <div class="flex flex-col items-start mb-4 bubble-enter w-full">
                        <div class="bg-[#FFEEDB] text-[#7A644D] text-[10px] font-bold mx-auto px-3 py-1.5 rounded-lg shadow-sm mb-4 text-center max-w-[90%]">
                            🔒 Demo Sistem Parser Otomatis
                        </div>
                        <div class="max-w-[85%] rounded-2xl px-4 py-2.5 shadow-sm text-[13px] leading-relaxed bg-white text-gray-800 rounded-tl-sm relative break-words">
                            ${text}
                            <div class="text-[10px] text-gray-400 mt-1 text-right">${time}</div>
                        </div>
                    </div>
                `;
            } 
            else if (type === 'user') {
                bubbleHTML = `
                    <div class="flex flex-col items-end mb-4 bubble-enter w-full">
                        <div class="max-w-[85%] rounded-2xl px-4 py-2.5 shadow-sm text-[13px] leading-relaxed bg-[#dcf8c6] text-gray-900 rounded-tr-sm relative break-words">
                            ${text}
                            <div class="text-[10px] text-gray-500 mt-1 text-right flex items-center justify-end gap-1">
                                ${time} <i data-lucide="check-check" class="w-3 h-3 text-blue-500"></i>
                            </div>
                        </div>
                    </div>
                `;
            }
            else if (type === 'bot_reply') {
                bubbleHTML = `
                    <div class="flex flex-col items-start mb-4 bubble-enter w-full">
                        <div class="max-w-[85%] rounded-2xl px-4 py-2.5 shadow-sm text-[13px] leading-relaxed bg-white text-gray-800 rounded-tl-sm relative border border-emerald-100 break-words">
                            <div class="font-bold text-emerald-600 mb-1 flex items-center gap-1.5 border-b border-gray-100 pb-1">
                                <i data-lucide="bot" class="w-4 h-4"></i> Data Diekstrak:
                            </div>
                            <ul class="space-y-0.5 mt-1">
                                <li>📍 Blok: <strong>${rawData.blok}</strong></li>
                                <li>🌴 Janjang: <strong>${rawData.janjang}</strong></li>
                                <li>⚖️ Berat: <strong>${rawData.tonase} Ton</strong></li>
                                ${rawData.afkir > 0 ? `<li class="text-red-600">⚠️ Mentah/Rusak: <strong>${rawData.afkir}</strong></li>` : ''}
                                <li>👤 Oleh: <strong>${rawData.pelapor}</strong></li>
                            </ul>
                            <div class="text-[10px] text-gray-400 mt-2 text-right">${time}</div>
                        </div>
                    </div>
                `;
            }
            else if (type === 'typing') {
                bubbleHTML = `
                    <div id="bot-typing-indicator" class="flex flex-col items-start mb-4 bubble-enter w-full">
                        <div class="bg-white rounded-2xl rounded-tl-sm px-4 py-3 shadow-sm flex items-center gap-1.5 w-fit">
                            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-bounce"></div>
                            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-bounce" style="animation-delay: 0.15s"></div>
                            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-bounce" style="animation-delay: 0.3s"></div>
                        </div>
                    </div>
                `;
            }

            if(type !== 'typing') {
                const existingTyping = document.getElementById('bot-typing-indicator');
                if(existingTyping) existingTyping.remove();
            }

            chatBox.insertAdjacentHTML('beforeend', bubbleHTML);
            lucide.createIcons();
            chatBox.scrollTop = chatBox.scrollHeight; // Auto scroll
        };

        // Fungsi Update Tabel Admin
        const updateAdminDashboard = (data, rawText) => {
            if(emptyState) emptyState.style.display = 'none';

            // Update state total
            totalStats.janjang += data.janjang;
            totalStats.tonase += data.tonase;
            totalStats.afkir += data.afkir;

            // Animasi angka (Update DOM)
            statJanjang.innerText = formatNumber(totalStats.janjang);
            statJanjang.classList.add('text-emerald-500');
            
            statTonase.innerHTML = `${totalStats.tonase.toFixed(1)} <span class="text-xs lg:text-sm text-gray-500 font-bold">Ton</span>`;
            statTonase.classList.add('text-blue-500');
            
            statAfkir.innerHTML = `${totalStats.afkir} <span class="text-xs lg:text-sm text-gray-500 font-bold">Jjg</span>`;
            if(data.afkir > 0) statAfkir.classList.add('text-red-500');

            setTimeout(() => {
                statJanjang.classList.remove('text-emerald-500');
                statTonase.classList.remove('text-blue-500');
                statAfkir.classList.remove('text-red-500');
            }, 500);

            // Tambah baris ke tabel
            const tr = document.createElement('tr');
            tr.className = 'highlight-row border-b border-gray-50 last:border-0 group';
            tr.innerHTML = `
                <td class="px-5 py-3 whitespace-nowrap">
                    <div class="font-extrabold text-gray-800 text-[11px]">REC-00${recordCount++}</div>
                    <div class="text-[10px] text-gray-400 font-bold">${getTime()}</div>
                </td>
                <td class="px-5 py-3">
                    <span class="inline-flex items-center justify-center px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-700 font-extrabold text-[11px]">
                        ${data.blok}
                    </span>
                </td>
                <td class="px-5 py-3 text-center font-bold text-gray-700">${data.janjang}</td>
                <td class="px-5 py-3 text-center font-extrabold text-blue-600">${data.tonase.toFixed(1)} T</td>
                <td class="px-5 py-3 text-center">
                    ${data.afkir > 0 
                        ? `<span class="text-red-500 font-extrabold text-[11px]">${data.afkir} X</span>`
                        : `<span class="text-gray-300 font-bold text-[11px]">-</span>`
                    }
                </td>
                <td class="px-5 py-3">
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-bold text-[9px] shrink-0">
                            ${data.pelapor.substring(0,2).toUpperCase()}
                        </div>
                        <span class="font-bold text-gray-700 text-[11px]">${data.pelapor}</span>
                    </div>
                </td>
                <td class="px-5 py-3">
                    <div class="max-w-[150px] lg:max-w-[200px] truncate text-[10px] text-gray-500 italic bg-gray-50 px-2 py-1 rounded border border-gray-100" title="${rawText}">
                        "${rawText}"
                    </div>
                </td>
            `;
            
            // Prepend (tambah di paling atas)
            adminTableBody.insertBefore(tr, adminTableBody.firstChild);
        };

        // --- MESIN SKENARIO ANIMASI (THE DIRECTOR) ---
        const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

        // Fungsi untuk mengetik efek visual huruf demi huruf
        const typeTextAnimation = async (text, speed = 40) => {
            typingInput.textContent = '';
            typingInput.classList.remove('cursor-blink');
            typingInput.style.borderRight = "2px solid #047857"; // Solid cursor while typing
            
            for (let i = 0; i < text.length; i++) {
                typingInput.textContent += text.charAt(i);
                await sleep(speed + (Math.random() * 30)); // random delay for realism
            }
            
            typingInput.style.borderRight = "none";
            typingInput.classList.add('cursor-blink');
            await sleep(500); // Wait before sending
        };

        const simulateClickSend = async () => {
            sendBtn.classList.add('scale-90', 'bg-emerald-800');
            await sleep(150);
            sendBtn.classList.remove('scale-90', 'bg-emerald-800');
        };

        // Skenario Chat yang akan dijalankan
        const scenarios = [
            {
                raw: "Pagi min, lapor panen blok A4 dapet 150 janjang. beratnya kurleb 2.8 ton. ada afkir 3 dr sudirman",
                parsed: { blok: "A4", janjang: 150, tonase: 2.8, afkir: 3, pelapor: "Sudirman" }
            },
            {
                raw: "blok B2 selesai. 85 tandan saja, 1.2 ton. mentah 0. joko",
                parsed: { blok: "B2", janjang: 85, tonase: 1.2, afkir: 0, pelapor: "Joko" }
            },
            {
                raw: "Laporan harian dr pak agus. blok C9 udh dipanen semua total dpt 210 jjg. tonase nembus 4.5 ton. tp banyak yg busuk 12 jjg tolong dicatet",
                parsed: { blok: "C9", janjang: 210, tonase: 4.5, afkir: 12, pelapor: "Agus" }
            }
        ];

        // Eksekusi skenario utama
        const runSimulation = async () => {
            // 1. Bot Welcome Message
            addChatBubble('bot_welcome', 'Halo Pemanen! Ketik saja laporan hasil panen Anda seperti biasa. AI kami akan otomatis menyusunnya untuk Dashboard Pengepul.');
            await sleep(2000);

            // 2. Loop melalui skenario
            for (let i = 0; i < scenarios.length; i++) {
                const s = scenarios[i];

                // Animasi Ngetik
                await typeTextAnimation(s.raw);
                
                // Animasi Kirim
                await simulateClickSend();
                const userText = typingInput.textContent;
                typingInput.textContent = ''; // clear input
                addChatBubble('user', userText);

                // Bot loading (Parsing)
                await sleep(500);
                addChatBubble('typing');
                
                // Bot membalas dan Admin Table update bersamaan
                await sleep(1500); // Simulasi waktu proses API LLM
                addChatBubble('bot_reply', '', s.parsed);
                updateAdminDashboard(s.parsed, userText);

                // Jeda antar skenario
                await sleep(3500);
            }

            // Pesan Selesai
            await sleep(1000);
            addChatBubble('typing');
            await sleep(1000);
            addChatBubble('bot_welcome', '✅ Simulasi Selesai. Data lapangan masuk secara instan, tanpa format kaku, dan siap dipantau admin secara *real-time*.');
        };

        // Mulai simulasi 1 detik setelah halaman dimuat
        setTimeout(runSimulation, 1000);

    </script>
</body>
</html>
